# ==========================================
# Backend API - Reverse Proxy
# ==========================================

# Upstream : définit les serveurs backend
upstream api_backend {
    # Serveur principal
    server blogpress-api:8090 max_fails=3 fail_timeout=30s;

    # Si tu as plusieurs instances (load balancing)
    # server api2:8090 weight=1 max_fails=3 fail_timeout=30s;
    # server api3:8090 weight=1 max_fails=3 fail_timeout=30s backup;

    # Garder les connexions ouvertes
    keepalive 32;
}

# ==========================================
# Redirection HTTP → HTTPS (à activer après SSL)
