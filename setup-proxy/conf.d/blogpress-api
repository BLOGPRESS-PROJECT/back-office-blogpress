# ==========================================
# API Backend - HTTP (avant SSL)
# ==========================================
server {
    listen 80;
    server_name api.blogpress.com localhost;

    # Logs spécifiques à l'API
    access_log /var/log/nginx/api_access.log main;
    error_log /var/log/nginx/api_error.log warn;

    # Taille max des uploads
    client_max_body_size 10M;

    # ==========================================
    # Routes de l'API
    # ==========================================
    location / {
        # Rate limiting : 10 requêtes/seconde
        limit_req zone=api_limit burst=20 nodelay;

        # Proxy vers le backend
        proxy_pass http://api_backend;
        proxy_http_version 1.1;

        # Headers standards
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $server_name;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Buffers
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;

        # Keep-alive avec le backend
        proxy_set_header Connection "";

        # WebSocket support (si nécessaire)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # ==========================================
    # Routes spécifiques
    # ==========================================

    # Route de login avec rate limiting plus strict
    location /api/auth/login {
        limit_req zone=login_limit burst=5 nodelay;

        proxy_pass http://api_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health check endpoint (pas de logs)
    location /actuator/health {
        access_log off;
        proxy_pass http://api_backend;
    }

    # Servir les fichiers statiques (uploads)
    location /uploads/ {
        # Désactiver rate limiting pour les images
        limit_req off;

        # Headers de cache
        expires 1y;
        add_header Cache-Control "public, immutable";

        proxy_pass http://api_backend;
    }

    # ==========================================
    # Certbot challenge (pour obtenir SSL)
    # ==========================================
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # ==========================================
    # Bloquer les requêtes suspectes
    # ==========================================

    # Bloquer les bots malveillants
    if ($http_user_agent ~* (bot|crawler|spider|scraper)) {
        return 403;
    }

    # Bloquer les méthodes HTTP non autorisées
    if ($request_method !~ ^(GET|POST|PUT|DELETE|PATCH|OPTIONS)$ ) {
        return 405;
    }
}

