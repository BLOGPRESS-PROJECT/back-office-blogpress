# ==========================================
# API Spring Boot - Reverse Proxy
# VERSION TEMPORAIRE : SANS HTTPS (pour obtenir les certificats)
# ==========================================

upstream api_backend {
    zone api_backend 64k;
    server blogpress-api:8090 max_fails=3 fail_timeout=30s resolve;
    keepalive 32;
}

# Configuration HTTP (temporaire, avant obtention des certificats)
server {
    listen 80;
    server_name api.blogpress-app.com;

    # Certbot challenge (IMPORTANT : doit être accessible)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Servir l'API en HTTP (temporairement, pas de redirection)
    location / {
        # Rate limiting : 10 requêtes/seconde
        limit_req zone=api_limit burst=20 nodelay;

        # Proxy vers le backend
        proxy_pass http://api_backend;
        proxy_http_version 1.1;

        # Headers standards
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $server_name;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Buffers
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;

        # Keep-alive avec le backend
        proxy_set_header Connection "";
    }

    # Routes spécifiques
    location /api/v1/auth/login {
        limit_req zone=login_limit burst=5 nodelay;

        proxy_pass http://api_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health check endpoint (pas de logs)
    location /actuator/health {
        access_log off;
        proxy_pass http://api_backend;
    }

    # Servir les fichiers statiques (uploads)
    location /uploads/ {
        # Désactiver rate limiting pour les images
        limit_req off;

        # Headers de cache
        expires 1y;
        add_header Cache-Control "public, immutable";

        proxy_pass http://api_backend;
    }
}

