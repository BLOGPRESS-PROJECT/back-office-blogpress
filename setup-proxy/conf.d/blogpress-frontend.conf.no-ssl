# ==========================================
# Blogpress - Frontend React
# VERSION TEMPORAIRE : SANS HTTPS (pour obtenir les certificats)
# ==========================================

upstream frontend_backend {
    server blogpress-webapp:80;
    keepalive 32;
}

# Mapping pour WebSocket (plus propre pour le paramètre Connection)
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ==========================================
# Configuration HTTP (temporaire, avant obtention des certificats)
# ==========================================
server {
    listen 80;
    server_name blogpress-app.com www.blogpress-app.com;

    access_log /var/log/nginx/frontend_access.log combined;
    error_log /var/log/nginx/frontend_error.log warn;

    # Certbot challenge (IMPORTANT : doit être accessible)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
        default_type text/plain;
        try_files $uri =404;
    }

    # Redirection non-www → www (HTTP uniquement pour l'instant)
    if ($host = 'blogpress-app.com') {
        return 301 http://www.blogpress-app.com$request_uri;
    }

    # Redirection /home vers / pour éviter les duplications SEO
    location = /home {
        return 301 http://www.blogpress-app.com/;
    }

    location = /home/ {
        return 301 http://www.blogpress-app.com/;
    }

    # Servir le frontend en HTTP (temporairement, pas de redirection HTTPS)
    location / {
        proxy_pass http://frontend_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_buffering off;
    }

    # Cache des assets statiques JavaScript (avec Content-Type explicite)
    location ~* \.js$ {
        proxy_pass http://frontend_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Content-Type "application/javascript; charset=utf-8" always;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Cache des autres assets statiques
    location ~* \.(css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|avif)$ {
        proxy_pass http://frontend_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # ==========================================
    # DIRECTIVES SEO
    # ==========================================

    # Sitemap XML
    location = /sitemap.xml {
        proxy_pass http://frontend_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Content-Type "application/xml; charset=utf-8" always;
        add_header Cache-Control "public, max-age=3600" always;
        add_header X-Robots-Tag "all" always;
        access_log /var/log/nginx/frontend_seo.log main;
    }

    # Robots.txt
    location = /robots.txt {
        proxy_pass http://frontend_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Content-Type "text/plain; charset=utf-8" always;
        add_header Cache-Control "public, max-age=3600" always;
        access_log /var/log/nginx/frontend_seo.log main;
    }

    # Favicon
    location = /favicon.ico {
        proxy_pass http://frontend_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
        log_not_found off;
    }

    # Web App Manifest (PWA)
    location = /manifest.json {
        proxy_pass http://frontend_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Content-Type "application/manifest+json; charset=utf-8" always;
        add_header Cache-Control "public, max-age=86400" always;
        access_log off;
    }

    # Fichiers de vérification Google Search Console
    location ~* ^/google[a-zA-Z0-9]+\.html$ {
        proxy_pass http://frontend_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Content-Type "text/html; charset=utf-8" always;
        access_log /var/log/nginx/frontend_seo.log main;
    }

    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
