# ==========================================
# Blogpress API — Production .env example
# ==========================================
# Copier vers le VPS :
#   scp setup-api/.env.prod.example user@vps:~/blogpress/setup-api/.env
# Puis renseigner les secrets (ne jamais committer .env).
# ==========================================

# Image (écrasée par la CI à chaque deploy)
BLOGPRESS_API_IMAGE=azerty78/blogpress-api:latest

# Spring
SPRING_PROFILE=docker
API_PORT=4006

# URLs publiques
APP_BASE_URL=https://api.blogpress-app.com
APP_FRONTEND_URL=https://blogpress-app.com
ALLOWED_ORIGINS=https://blogpress-app.com,https://www.blogpress-app.com

# MongoDB
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MONGO_DATABASE=blogpress
MONGO_AUTO_INDEX=true

# JWT
JWT_SECRET=CHANGE_ME_LONG_BASE64_SECRET
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Admin bootstrap
ADMIN_EMAIL=admin@blogpress-app.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_USERNAME=admin
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=Blogpress

# File storage
FILE_STORAGE_MAX_FILE_SIZE=10485760
FILE_STORAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=10MB

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_MONGO=WARN

# JVM
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
