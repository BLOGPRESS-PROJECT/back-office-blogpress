# ==========================================
# Blogpress API — Production .env example
# ==========================================
# Copier vers le VPS :
#   scp setup-api/.env.prod.example user@vps:~/blogpress/setup-api/.env
# Puis renseigner les secrets (ne jamais committer .env).
# ==========================================

# Image (écrasée par la CI à chaque deploy)
BLOGPRESS_API_IMAGE=azerty78/blogpress-api:latest

# Spring
SPRING_PROFILE=prod
API_PORT=8090

# URLs publiques
APP_BASE_URL=https://api.blogpress-app.com
APP_FRONTEND_URL=https://www.blogpress-app.com
ALLOWED_ORIGINS=https://www.blogpress-app.com,https://blogpress-app.com

# MongoDB
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MONGO_DATABASE=blogpress
MONGO_AUTO_INDEX=true

# JWT
JWT_SECRET=CHANGE_ME_LONG_BASE64_SECRET
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Admin bootstrap
ADMIN_EMAIL=admin@blogpress.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_USERNAME=admin
ADMIN_FIRSTNAME=Super
ADMIN_LASTNAME=Admin

# File storage
FILE_STORAGE_MAX_FILE_SIZE=5242880
FILE_STORAGE_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp
MULTIPART_MAX_FILE_SIZE=5MB
MULTIPART_MAX_REQUEST_SIZE=10MB

# Logging
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
LOG_LEVEL_MONGO=WARN

# JVM
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
