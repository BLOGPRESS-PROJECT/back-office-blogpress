# ==========================================
# BLOGPRESS API - Configuration
# ==========================================
# Local : docker compose up -d          → MongoDB seul
# Prod  : docker compose --profile prod up -d → API + MongoDB
# ==========================================

# Spring
SPRING_PROFILE=prod
API_PORT=8090

# URLs
APP_BASE_URL=http://localhost:8090
APP_FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5174

# MongoDB (credentials du container)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=qwerty87
MONGO_DATABASE=blogpress
MONGO_PORT=27017
# URI pour l'app locale (hors Docker) → localhost
# En prod, docker-compose reconstruit l'URI via le hostname "mongodb"
SPRING_DATA_MONGODB_URI=mongodb://root:qwerty87@localhost:27017/blogpress?authSource=admin
MONGO_AUTO_INDEX=true

# JWT
JWT_SECRET=VGhpcyBpcyBhIHZlcnkgc2VjdXJlIGFuZCBsb25nIHNlY3JldCBrZXkgZm9yIEJsb2dwcmVzcyBBUEkgMjAyNQ==
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Admin
ADMIN_EMAIL=bendjibril789@gmail.com
ADMIN_PASSWORD=azerty@78942004
ADMIN_USERNAME=Azerty_78
ADMIN_FIRSTNAME=Ben
ADMIN_LASTNAME=Djibril

# File storage
FILE_STORAGE_BASE_PATH=./uploads
FILE_STORAGE_MAX_FILE_SIZE=5242880
FILE_STORAGE_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp
MULTIPART_MAX_FILE_SIZE=5MB
MULTIPART_MAX_REQUEST_SIZE=10MB

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_MONGO=INFO
LOG_LEVEL_SECURITY=DEBUG
LOG_LEVEL_WEB=INFO

# Java / DevTools
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
DEVTOOLS_ENABLED=true

# Docker Hub (pull image en prod)
DOCKERHUB_USERNAME=azerty78
