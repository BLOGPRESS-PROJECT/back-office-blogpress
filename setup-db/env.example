# ==========================================
# Configuration MongoDB - Variables d'environnement
# ==========================================
# 
# Instructions :
# 1. Copiez ce fichier vers .env
# 2. Modifiez les valeurs selon vos besoins
# 3. Le fichier .env est ignoré par git (.gitignore)
#
# cp env.example .env
# (ou sur Windows: copy env.example .env)
#

# Nom d'utilisateur root MongoDB
MONGO_ROOT_USERNAME=root

# Mot de passe root MongoDB
MONGO_ROOT_PASSWORD=qwerty87

# Nom de la base de données
MONGO_DATABASE=blogpress

# Port MongoDB (exposé sur l'hôte)
MONGO_PORT=27017

