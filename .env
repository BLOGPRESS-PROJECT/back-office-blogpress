
# MongoDB Atlas (Production)
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/blogpress?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=VGhpcyBpcyBhIHZlcnkgc2VjdXJlIGFuZCBsb25nIHNlY3JldCBrZXkgZm9yIEJsb2dwcmVzcyBBUEkgMjAyNQ==
JWT_ACCESS_TOKEN_EXPIRATION=3600000
