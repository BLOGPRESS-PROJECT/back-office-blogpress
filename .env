# File Upload
FILE_UPLOAD_DIR=/app/uploads

# CORS (Frontend URL)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Spring Profile
SPRING_PROFILES_ACTIVE=prod


# ==========================================
# BLOGPRESS - Configuration Globale
# ==========================================

# ===== MONGODB =====
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change_me_in_production
MONGO_DATABASE=blogpress
MONGO_PORT=27017

# ===== API =====
VERSION=1.0.0
API_PORT=8090
SPRING_PROFILE=docker

# ===== JWT =====
JWT_SECRET=CHANGE_ME_TO_SECURE_BASE64_ENCODED_SECRET
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ===== URLs =====
APP_BASE_URL=http://localhost:8090
FRONTEND_URL=http://localhost:3000

# ===== ADMIN =====
ADMIN_EMAIL=admin@blogpress.com
ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION
ADMIN_USERNAME=admin
ADMIN_FIRSTNAME=Super
ADMIN_LASTNAME=Admin

# ===== FILE STORAGE =====
FILE_STORAGE_MAX_SIZE=5242880

# ===== JAVA =====
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC

# ===== NGINX (si utilisé) =====
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
DOMAIN=api.blogpress.com